<?xml version="1.0" encoding="utf-8"?>
<!-- The application-level icon, which Android draws on notifications. It is
     a plain disc in the notification card's own colour, so it cannot be
     seen there. (A transparent icon is drawn as a black disc.) -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/notification_card" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
