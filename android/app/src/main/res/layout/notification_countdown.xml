<?xml version="1.0" encoding="utf-8"?>
<!-- The lock screen card: [picture, if chosen] title ...... 100d 20:20:59 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/countdown_image"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdown_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="15sp" />

    <!-- Ticks every second by itself; the app only resets it once a day. -->
    <Chronometer
        android:id="@+id/countdown_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Shown instead of the timer once the event has started. -->
    <TextView
        android:id="@+id/countdown_now"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
